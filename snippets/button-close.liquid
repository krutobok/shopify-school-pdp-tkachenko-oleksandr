{% comment %}
  Props:
  - id: String (required)
  - class: String (optional)
  - aria_label: String (optional)
{% endcomment %}

<button
  type="button"
  id="{{ id }}"
  class="group cursor-pointer flex items-center justify-center outline-none focus-visible:ring-2 focus-visible:ring-foreground transition-colors text-foreground hover:text-secondary {{ class }}"
  aria-label="{{ aria_label | default: 'accessibility.close' | t }}"
>
  <svg
    aria-hidden="true"
    width="15"
    height="15"
    viewBox="0 0 15 15"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="w-4 h-4 md:w-[15px] md:h-[15px] text-current"
  >
    <path d="M1.5 1.5L13.5 13.5M1.5 13.5L13.5 1.5" stroke="currentColor" stroke-width="2"/>
  </svg>
</button>
